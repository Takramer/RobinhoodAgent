<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.thomaskramer.robinhoodagent</string>

  <!-- Runs from ~/TradingRuntime (NOT ~/Downloads): launchd jobs have no TCC
       access to Downloads, which is why the old job exited 126. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/thomaskramer/TradingRuntime/RobinhoodAgent/run_scheduled.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/thomaskramer/TradingRuntime/RobinhoodAgent</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
    <!-- Midday rescans dropped: they existed to refresh entry candidates, and
         entries are off (config.json entries_enabled=false). Stage 2 rebuilds
         plan.json from live state each run, so exits stay current without them.
         Add them back when entries are re-enabled. -->
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/thomaskramer/TradingRuntime/RobinhoodAgent/logs/session.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/thomaskramer/TradingRuntime/RobinhoodAgent/logs/session_error.log</string>

  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
